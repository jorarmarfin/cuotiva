  "fixed_sql": [
    {
      "name": "spaces",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"spaces\" (\"id\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"name\" TEXT NOT NULL, \"type\" TEXT NOT NULL DEFAULT 'other', \"color\" INTEGER NOT NULL, \"icon\" TEXT NOT NULL DEFAULT 'folder', \"description\" TEXT NULL, \"archived_at\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "contacts",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"contacts\" (\"id\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"display_name\" TEXT NOT NULL, \"phone\" TEXT NULL, \"email\" TEXT NULL, \"notes\" TEXT NULL, \"archived_at\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "collections",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"collections\" (\"id\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"space_id\" TEXT NOT NULL REFERENCES spaces (id), \"title\" TEXT NOT NULL, \"kind\" TEXT NOT NULL DEFAULT 'other', \"funds_ownership\" TEXT NOT NULL DEFAULT 'self', \"due_at\" INTEGER NULL, \"notes\" TEXT NULL, \"archived_at\" INTEGER NULL, PRIMARY KEY (\"id\"), CHECK (funds_ownership IN ('self','third_party')), CHECK (kind IN ('credit_sale','loan','fundraising','service','other')));"
        }
      ]
    },
    {
      "name": "receivables",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"receivables\" (\"id\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"collection_id\" TEXT NOT NULL REFERENCES collections (id), \"contact_id\" TEXT NOT NULL REFERENCES contacts (id), \"principal_minor\" INTEGER NOT NULL, \"currency\" TEXT NOT NULL DEFAULT 'PEN', \"due_at\" INTEGER NULL, \"notes\" TEXT NULL, \"cancelled_at\" INTEGER NULL, PRIMARY KEY (\"id\"), CHECK (principal_minor > 0), UNIQUE (collection_id, contact_id));"
        }
      ]
    },
    {
      "name": "installments",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"installments\" (\"id\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"receivable_id\" TEXT NOT NULL REFERENCES receivables (id), \"sequence\" INTEGER NOT NULL, \"due_at\" INTEGER NOT NULL, \"amount_minor\" INTEGER NOT NULL, PRIMARY KEY (\"id\"), CHECK (amount_minor > 0), CHECK (sequence > 0), UNIQUE (receivable_id, sequence));"
        }
      ]
    },
    {
      "name": "audit_logs",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"audit_logs\" (\"id\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"entity_type\" TEXT NOT NULL, \"entity_id\" TEXT NOT NULL, \"action\" TEXT NOT NULL, \"old_values_json\" TEXT NULL, \"new_values_json\" TEXT NULL, \"occurred_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "app_settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"app_settings\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    },
    {
      "name": "payments",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"payments\" (\"id\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"receivable_id\" TEXT NOT NULL REFERENCES receivables (id), \"amount_minor\" INTEGER NOT NULL, \"currency\" TEXT NOT NULL DEFAULT 'PEN', \"occurred_at\" INTEGER NOT NULL, \"method\" TEXT NOT NULL DEFAULT 'cash', \"status\" TEXT NOT NULL DEFAULT 'pending_verification', \"reference\" TEXT NULL, \"notes\" TEXT NULL, \"verified_at\" INTEGER NULL, \"voided_at\" INTEGER NULL, \"void_reason\" TEXT NULL, \"installment_id\" TEXT NULL, PRIMARY KEY (\"id\"), CHECK (amount_minor > 0), CHECK (status IN ('pending_verification','confirmed','rejected','voided')), CHECK (method IN ('cash','yape','plin','transfer','card','other')));"
        }
      ]
    },
    {
      "name": "payment_allocations",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"payment_allocations\" (\"id\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"payment_id\" TEXT NOT NULL REFERENCES payments (id), \"installment_id\" TEXT NOT NULL REFERENCES installments (id), \"amount_minor\" INTEGER NOT NULL, PRIMARY KEY (\"id\"), CHECK (amount_minor > 0), UNIQUE (payment_id, installment_id));"
        }
      ]
