    {
      "name": "attachments",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"attachments\" (\"id\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"payment_id\" TEXT NOT NULL REFERENCES payments (id), \"relative_path\" TEXT NOT NULL, \"mime_type\" TEXT NOT NULL, \"byte_size\" INTEGER NOT NULL, \"checksum\" TEXT NOT NULL, \"encrypted\" INTEGER NOT NULL DEFAULT 0 CHECK (\"encrypted\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
