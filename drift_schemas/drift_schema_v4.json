          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"settlements\" (\"id\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"collection_id\" TEXT NOT NULL REFERENCES collections (id), \"amount_minor\" INTEGER NOT NULL, \"currency\" TEXT NOT NULL DEFAULT 'PEN', \"occurred_at\" INTEGER NOT NULL, \"status\" TEXT NOT NULL DEFAULT 'confirmed', \"recipient_name\" TEXT NULL, \"notes\" TEXT NULL, \"voided_at\" INTEGER NULL, \"void_reason\" TEXT NULL, PRIMARY KEY (\"id\"), CHECK (amount_minor > 0), CHECK (status IN ('confirmed','voided')));"
